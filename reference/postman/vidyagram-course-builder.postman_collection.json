        {
          "name": "My Courses shows the partial build",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{base}}/courses/my-courses",
              "host": [
                "{{base}}"
              ],
              "path": [
                "courses",
                "my-courses"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{ \"userId\": \"{{studentId}}\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const groups = pm.response.json().data || [];",
                  "const c = groups.flatMap(g => [...(g.liveCourses || []), ...(g.recordedCourses || [])]).find(x => String(x._id || x.id) === pm.collectionVariables.get('courseId'));",
                  "pm.test('course listed', () => pm.expect(c, 'course not in My Courses').to.be.an('object'));",
                  "pm.test('isPartial with owned chapters', () => { pm.expect(c.isPartial).to.eql(true); pm.expect(c.ownedTopicIds).to.include(pm.collectionVariables.get('boughtTopicId')); });"
                ]
              }
            }
          ]
        },
