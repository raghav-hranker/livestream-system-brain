  "item": [
    {
      "name": "1. Admin: builder settings",
      "item": [
        {
          "name": "Course outline (picks class ids for later requests)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/courses/{{courseId}}/class-groups",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "courses",
                "{{courseId}}",
                "class-groups"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const sections = pm.response.json().data.sections;",
                  "const topics = sections.flatMap(s => s.topics).filter(t => t.topicId);",
                  "const paid = t => t.groups.flatMap(g => g.listings).find(l => !l.isFree);",
                  "const bought = topics.find(t => paid(t)), other = [...topics].reverse().find(t => t.topicId !== bought.topicId && paid(t));",
                  "pm.collectionVariables.set('boughtTopicId', bought.topicId);",
                  "pm.collectionVariables.set('otherTopicId', other.topicId);",
                  "pm.collectionVariables.set('boughtClassId', paid(bought).classId);",
                  "pm.collectionVariables.set('boughtPlacementId', paid(bought).placementId);",
                  "pm.collectionVariables.set('otherClassId', paid(other).classId);",
                  "console.log('bought chapter', bought.topicName, '| other chapter', other.topicName);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get builder settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/courses/{{courseId}}/builder",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "courses",
                "{{courseId}}",
                "builder"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json().data.builder;",
                  "pm.test('course has builder settings', () => pm.expect(b, 'save settings in Builder mode first').to.be.an('object'));",
                  "const { version, ...settings } = b;",
                  "pm.collectionVariables.set('builderSettingsJson', JSON.stringify(settings));",
                  "pm.collectionVariables.set('allTopicIdsJson', JSON.stringify(settings.chapters.filter(c => c.weight > 0 || c.customPrice != null).map(c => c.topicId)));"
                ]
              }
            }
          ]
        },
