  "item": [
    {
      "name": "…0894 — RRB Batch: original ₹1899, current list ₹1699 ⇒ ₹850 / 183 days",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_prod_ro}}/api/plans/filter-active/{{user_0894}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subscriptionId\": \"{{plan_rrb}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const plan = (pm.response.json().data || [])[0];",
              "pm.test('one plan returned', () => pm.expect(plan.id).to.eql(pm.collectionVariables.get('plan_rrb')));",
              "pm.test('₹850 = half of capped ₹1699 list, rounded up', () => pm.expect(plan.amount).to.eql('850'));",
              "pm.test('183 days', () => pm.expect(plan.duration).to.eql(183));",
              "pm.test('list price ₹1699 kept as originalAmount', () => pm.expect(plan.originalAmount).to.eql('1699'));",
              "pm.test('Extension title', () => pm.expect(plan.title).to.match(/ : Extension$/));",
              "pm.test('is_expire = 1', () => pm.expect(plan.is_expire).to.eql(1));"
            ]
          }
        }
      ]
    },
