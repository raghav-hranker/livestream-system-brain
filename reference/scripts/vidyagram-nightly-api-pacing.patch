diff --git a/src/tests/apxCatalogHttpSourcePacing.test.ts b/src/tests/apxCatalogHttpSourcePacing.test.ts
new file mode 100644
index 000000000..1a12f4ce5
--- /dev/null
+++ b/src/tests/apxCatalogHttpSourcePacing.test.ts
@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import axios from 'axios';
+import { createHttpCatalogSource } from '../services/apx/apxCatalogHttpSource';
+
+test('concurrent folder calls are serial and paced, including after a failed response', async (t) => {
+  const starts: number[] = [];
+  const ends: number[] = [];
+  let active = 0;
+  let maxActive = 0;
+  t.mock.method(axios, 'get', async () => {
+    const index = starts.length;
+    starts.push(Date.now());
+    maxActive = Math.max(maxActive, ++active);
+    await new Promise(resolve => setTimeout(resolve, 20));
+    active--;
+    ends[index] = Date.now();
+    if (index === 0) throw new Error('connection reset');
+    return { status: 200, data: { data: [{ id: String(index) }], total: 1 } };
+  });
+  const source = createHttpCatalogSource({
+    db: {} as any, customerId: '781', orgId: '2177599', tenantApiBase: 'https://example.invalid', studentGapMs: 100,
+  });
+  const results = await Promise.allSettled(['-1', '10', '20'].map(parent => source.folderContents('85', parent)));
+  assert.equal(results[0].status, 'rejected');
+  assert.equal(results[1].status, 'fulfilled');
+  assert.equal(results[2].status, 'fulfilled');
+  assert.equal(maxActive, 1);
+  assert.ok(starts[1] - ends[0] >= 90, 'failure must not bypass the gap');
+  assert.ok(starts[2] - ends[1] >= 90, 'concurrent callers must not bypass the gap');
+});
